/* photo integration (AUK campus photograph) */
.hero.hp{background-image:linear-gradient(180deg,rgba(26,6,12,.10) 0%,rgba(26,6,12,.52) 100%),linear-gradient(90deg,rgba(26,6,12,.62),rgba(26,6,12,0) 72%),var(--photo),var(--art);background-position:center,center,46% 40%,center}
.hp .glass{background:rgba(30,8,14,.50);border-color:rgba(255,255,255,.30)}
.hp .disc{color:rgba(255,255,255,.86)}
@media (min-width:700px){.hero.hp{background-position:center,center,0% 40%,center}.hp h1{font-size:clamp(34px,4.4vw,46px)}.hp .glass{width:min(100%,540px)}.hero.hp{min-height:min(74vh,520px)}}
@media (max-width:520px){.hero.hp{min-height:0;padding-top:250px;background-image:linear-gradient(180deg,rgba(26,6,12,.10) 0%,rgba(26,6,12,.30) 40%,rgba(26,6,12,.50) 100%),linear-gradient(180deg,rgba(26,6,12,0) 190px,rgba(26,6,12,1) 340px),var(--photo),var(--art);background-size:cover,cover,auto 340px,cover;background-position:center,center,47% 0,center;background-repeat:no-repeat}}
</style></head><body>
<header><div class="brand"><b>AUK ANALYTICS</b><span>Independent project · not official</span></div><nav id="nav" aria-label="Sections"></nav></header>
<main id="app"></main>
<footer><p><b>Independent Project — Not Officially Endorsed by the American University of Kuwait (AUK).</b> Built only from publicly available institutional, regulatory and ranking sources. Maroon and gold styling approximates the identity stated on AUK's partner page and visible on campus signage; no AUK logo is reproduced.</p><p>Created &amp; Developed by Abdulrahman Faraj | Independent Analytics Project</p></footer>
<script>
const S={cat:'https://www.auk.edu.kw/media/fiflp3ri/2025-2026-auk-catalog-full-28sep2026.pdf',home:'https://www.auk.edu.kw/',oir:'https://www.auk.edu.kw/who-we-are/administration/office-of-institutional-research',pub:'https://www.auk.edu.kw/media-hub/university-publication/',dart:'http://www.dartmouth.edu/aukprogram/about/about_auk.php',qs:'https://www.topuniversities.com/universities/american-university-kuwait',uni:'https://www.unirank.org/kw/uni/american-university-of-kuwait/',cic:'https://cic.edu/membership/international-profiles/american-university-of-kuwait/',eda:'https://www.edarabia.com/1184/american-university-of-kuwait/',wiki:'https://en.wikipedia.org/wiki/American_University_of_Kuwait',nat:'https://www.nature.com/nature-index/country-outputs/Kuwait',csb:'https://www.csb.gov.kw/Pages/Statistics_en?ID=58&ParentCatID=+70'};
const a=(u,t)=>`<a class="x" href="${u}" target="_blank" rel="noopener">${t}</a>`;
const f=n=>n.toLocaleString('en-US');const pct=(x,y)=>(x/y*100);
const kpi=(v,l,t)=>`<div class="c"><div class="k">${v}</div><div class="l">${l}</div><span class="t">${t}</span></div>`;
const src=s=>`<p class="src">Source: ${s}</p>`;
const na=t=>`<div class="c na"><b>${t}</b><br>Data not publicly available</div>`;
const dtag=id=>`<span class="t d">Data discrepancy ${id}</span>`;
const HC=[
{k:'AUK partner page (Dartmouth)',v:2419,w:'Fall 2018',ty:'University-supplied',u:S.dart,c:'#7b1a2e'},
{k:'AUK website, cached (c.2023)',v:2256,w:'c.2023 (floor: “2256+”)',ty:'Official (dated)',u:S.home,c:'#7b1a2e'},
{k:'QS profile',v:2077,w:'Undated',ty:'Ranking',u:S.qs,c:'#a85d00'},
{k:'Edarabia directory',v:3000,w:'Undated (approx.)',ty:'Secondary',u:S.eda,c:'#8a8f99'},
{k:'CIC profile (9,000 UG + 1,000 grad)',v:10000,w:'Undated',ty:'Secondary',u:S.cic,c:'#8a8f99'}];
const PROG=[['Design (Graphic Design)','BA','Arts & Sciences','NASAD substantial equivalency'],['Communication and Media','BA','Arts & Sciences','College: AALE'],['English','BA','Arts & Sciences','College: AALE'],['International Relations','BA','Arts & Sciences','College: AALE'],['Social & Behavioral Sciences (Anthropology)','BA','Arts & Sciences','College: AALE'],
['Accounting','BBA','Business & Economics','College: AACSB'],['Economics','BBA','Business & Economics','College: AACSB'],['Finance','BBA','Business & Economics','College: AACSB'],['Human Resource Management','BBA','Business & Economics','College: AACSB'],['Management','BBA','Business & Economics','College: AACSB'],['Marketing','BBA','Business & Economics','College: AACSB'],
['Computer Engineering','BE','Engineering & Applied Sciences','ABET EAC'],['Electrical Engineering','BE','Engineering & Applied Sciences','ABET EAC'],['Systems Engineering','BE','Engineering & Applied Sciences','Not listed'],['Computer Science','BS','Engineering & Applied Sciences','ABET CAC'],['Information Systems','BS','Engineering & Applied Sciences','Not listed']];
const ins=(m,fa,i,q,r)=>`<div class="c ins"><h3>${m}</h3><em>Fact</em><p>${fa}</p><em>Insight</em><p>${i}</p><em>Management question</em><p>${q}</p><em>Recommendation (analyst judgment)</em><p>${r}</p></div>`;
function spread(){const W=640,r=HC.slice().sort((x,y)=>x.v-y.v),H=r.length*34+10;const mx=10500;
return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Five public student figures from 2,077 to 10,000">${r.map((d,i)=>`<text x="0" y="${i*34+20}" style="fill:var(--ink)">${d.k.length>36?d.k.slice(0,35)+'…':d.k}</text><rect x="260" y="${i*34+7}" width="${(W-320)*d.v/mx}" height="17" rx="4" fill="${d.c}"/><text x="${264+(W-320)*d.v/mx}" y="${i*34+20}">${f(d.v)}${d.k.includes('2256')||d.v==3000?(d.v==3000?'':'+'):''}</text>`).join('')}</svg>`}
function bars(rows,mx,unit){return rows.map(([n,v,c])=>`<div style="margin:10px 0"><div style="display:flex;justify-content:space-between;font-size:14px"><span>${n}</span><b>${v}${unit||''}</b></div><div class="bm"><i style="width:${v/mx*100}%;${c?'background:'+c:''}"></i></div></div>`).join('')}
const V={};
V.overview=()=>`<div class="hero hp"><div class="glass"><div class="eyebrow">Independent Analytics Project</div><h1>AUK Institutional Analytics</h1><p class="sub">Data-Driven View of Student &amp; Institutional Performance</p><p class="lead">American University of Kuwait, Salmiya · liberal arts institution established by Amiri Decree in 2003.</p><div class="by"><span>Created &amp; Developed by <b>Abdulrahman Faraj</b></span><small>Data Analysis • Business Intelligence • Institutional Research • Data Visualization</small></div><p class="disc">Independent Project — Not Officially Endorsed by the American University of Kuwait (AUK).</p><a class="cta" href="#overview" onclick="event.preventDefault();document.getElementById('explore').scrollIntoView({behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'auto':'smooth'})">Explore Analytics <span aria-hidden="true">→</span></a></div><div class="credit" id="credit">Photo: AUK campus, supplied by the project author</div></div>
<div class="g">${kpi('2,256+','Students on AUK website, c.2023','Official (dated)')}${kpi('123','Faculty members, catalog 2025–26','Official')}${kpi('92%','Faculty with PhD or terminal degree','Official')}${kpi('&gt;50%','Students on scholarships','Official')}${kpi('16','Undergraduate majors in 3 colleges','Official')}${kpi('7','International accreditation statements','Official')}</div>
<div class="c"><h3>Public student figures, by source</h3>${spread()}<p class="l">Five figures with different dates and bases; the 10,000 figure is implausible next to the others. ${dtag('D1')}</p>${src(a(S.dart,'AUK partner page')+'; '+a(S.home,'AUK website (cached)')+'; '+a(S.qs,'QS')+'; '+a(S.eda,'Edarabia')+'; '+a(S.cic,'CIC')+'.')}</div>
<div class="c" style="margin-top:12px;border-left:4px solid var(--blue)"><h3>Key finding</h3><p style="margin:0">AUK’s own catalog gives rich institutional detail (faculty, accreditation, fees, rules), but no current enrollment, retention or graduation figures are public. Third-party headcounts range from 2,077 to 10,000, so the data suggests definitions need standardising. <a class="x" href="#students">Detailed analysis →</a></p></div>
<h2 id="explore">Explore the analysis</h2><div class="g2">${[['students','Students &amp; Enrollment','Headcount sources, Fall 2018 composition, gaps'],['admissions','Admissions','Requirements, deadlines, fees; outcomes not public'],['journey','Student Journey','Policy path from IEP to graduation'],['programs','Colleges &amp; Programs','Filterable 16-major portfolio with accreditation'],['demographics','Demographics','Scholarship share and what is not public'],['faculty','Faculty &amp; Staff','Counts, PhD share and discrepancies'],['research','Research','Nature Index signal and research offices'],['quality','Accreditation &amp; Quality','PUC, AACSB, ABET, AALE, NASAD, CEA, Dartmouth'],['benchmark','Benchmark','Kuwait Nature Index peers'],['insights','Insights','Seven findings with recommendations']].map(([h,t,d])=>`<a class="c nav" href="#${h}"><b>${t}</b><span>${d}</span><i>View Detailed Analysis →</i></a>`).join('')}</div>`;
V.students=()=>`<h1>Students &amp; Enrollment</h1><p class="lead">No current official enrollment is published. Six third-party or dated figures are shown side by side, with one composition snapshot.</p>
<div class="g">${kpi('2,419','Fall 2018, UG 2,219 + IEP 200','University-supplied')}${kpi('2,256+','c.2023 AUK website (floor)','Official (dated)')}${kpi('2,077','QS profile, undated','Ranking')}${kpi('Not public','Current Fall enrollment','Unavailable')}</div>
<div class="c"><h3>Student figures by source</h3>${spread()}<p class="l">${dtag('D1')} The CIC figure lists 1,000 graduate students although AUK’s catalog lists only undergraduate majors and an English program. ${dtag('D2')}</p></div>
<h2>Reported figures</h2><div class="c tw"><table class="wr"><tr><th>Figure</th><th>Source</th><th>Period</th><th>Type</th></tr><tr><td>2,419</td><td>${a(S.dart,'AUK partner page (Dartmouth)')}</td><td>Fall 2018</td><td>University-supplied</td></tr><tr><td>2,256+</td><td>${a(S.home,'AUK website, cached')}</td><td>c.2023</td><td>Official (dated)</td></tr><tr><td>2,077</td><td>${a(S.qs,'QS')}</td><td>Undated</td><td>Ranking</td></tr><tr><td>2,000–2,999</td><td>${a(S.uni,'uniRank')}</td><td>Undated range</td><td>Secondary</td></tr><tr><td>≈3,000</td><td>${a(S.eda,'Edarabia')}</td><td>Undated</td><td>Secondary</td></tr><tr><td>9,000 UG + 1,000 grad</td><td>${a(S.cic,'CIC')}</td><td>Undated</td><td>Secondary</td></tr></table></div>
<h2>Composition, Fall 2018</h2><div class="c"><svg viewBox="0 0 640 70" role="img" aria-label="Undergraduate 91.7 percent, English program 8.3 percent"><rect x="10" y="12" width="${620*2219/2419}" height="30" fill="#7b1a2e"/><rect x="${10+620*2219/2419}" y="12" width="${620*200/2419}" height="30" fill="#e9b21f"/><text x="14" y="62">Undergraduate 2,219 (91.7%)</text><text x="626" y="62" text-anchor="end">Intensive English 200 (8.3%)</text></svg><p class="l">2,219 + 200 = 2,419, so the components reconcile. <span class="t">Calculated</span></p>${src(a(S.dart,'AUK partner page')+'.')}</div>
<div class="c" style="margin-top:12px"><h3>Why no growth rate is shown</h3><p style="margin:0">The only two official-style figures (2,419 in Fall 2018; 2,256+ around 2023) differ in date precision, one is a floor, and the earlier one includes the English program while the later definition is unstated. Computing a change would imply precision the sources do not support.</p></div>
<div class="g2" style="margin-top:12px">${na('Fall enrollment series by year')}${na('New vs continuing students')}${na('Full-time / part-time students')}${na('Enrollment by college or major')}</div>
<p class="src">AUK’s Office of Institutional Research states it monitors enrollment, retention, graduation and faculty demographics, but publishes no fact book (${a(S.oir,'OIR page')}). Wikipedia states “over 6,000 graduates”, undated and uncited (${a(S.wiki,'Wikipedia')}); it is not used.</p>`;
V.admissions=()=>`<h1>Admissions</h1><p class="lead">AUK publishes detailed requirements, deadlines and fees, but no applications, offers, acceptance rate or yield.</p>
<div class="g">${kpi('KWD 210','Tuition per credit hour (230 engineering)','Official')}${kpi('KWD 20','Application fee','Official')}${kpi('4 weeks','Typical decision time after complete application','Official')}${kpi('Not public','Acceptance rate (uniRank: not reported)','Unavailable')}</div>
<div class="c tw"><h3>Application deadlines, 2025–26 cycle</h3><table><tr><th>Term</th><th>Kuwait-based</th><th>International</th></tr><tr><td>Fall 2025</td><td>Aug 21, 2025</td><td>Jun 1, 2025</td></tr><tr><td>Early admission Fall 2025</td><td>May 29, 2025</td><td>—</td></tr><tr><td>Spring 2026</td><td>Jan 25, 2026</td><td>Jan 7, 2026</td></tr><tr><td>Summer 2026</td><td>Jun 12, 2025</td><td>May 1, 2026</td></tr></table>${src(a(S.cat,'AUK Catalog 2025–26, p.22')+'. The Summer 2026 Kuwait-based date is printed as shown in the catalog.')}</div>
<h2>Entry requirements</h2><div class="g"><div class="c"><div class="k">60</div><div class="l">TOEFL iBT minimum (IELTS 6.0)</div><span class="t">Official</span></div><div class="c"><div class="k">106</div><div class="l">AUK English Placement Test minimum (essay 5)</div><span class="t">Official</span></div><div class="c"><div class="k">60% / 2.00</div><div class="l">Minimum high-school average (Kuwaiti government system)</div><span class="t">Official</span></div><div class="c"><div class="k">60</div><div class="l">Maximum transfer credits accepted</div><span class="t">Official</span></div></div>
<div class="c"><h3>What the catalog documents</h3><p style="margin:0">Admission is described as competitive and limited by capacity; applicants may be wait-listed. Program-specific rules apply: Computer Science, Electrical, Computer and Systems Engineering require the scientific high-school track. A KWD 100 non-refundable deposit confirms a seat. The Intensive English Program costs KWD 2,250 per semester.</p>${src(a(S.cat,'AUK Catalog 2025–26, pp.22–33, 44–45')+'.')}</div>
<div class="g2" style="margin-top:12px">${na('Applications')}${na('Offers / admits')}${na('Enrollment yield')}${na('New-student intake by term')}${na('Applicants by nationality')}${na('IEP-to-degree conversion')}</div>`;
V.journey=()=>`<h1>Student Journey</h1><p class="lead">The lifecycle is documented in policy. No stage has a published headcount, so every stage is marked unavailable.</p>
<div class="c"><h3>Lifecycle (policy path)</h3><div class="fn"><div class="n"><b>Applicants</b><small>Not public</small></div><div class="n"><b>Admitted</b><small>Not public</small></div><div><b>IEP</b><small>Semester 2 completion if required</small></div><div><b>45</b><small>General education credits</small></div><div><b>60</b><small>Credits then major declaration</small></div><div><b>124</b><small>Credits for graduation</small></div><div class="n"><b>Graduates</b><small>Annual count not public</small></div></div><p class="l">Stages show rules, not counts. <span class="t">Official</span></p>${src(a(S.cat,'AUK Catalog 2025–26, TOC, pp.22, 34, 50')+'.')}</div>
<h2>Rules that shape progression</h2><div class="g"><div class="c"><div class="k">2.00</div><div class="l">Minimum cumulative GPA for financial aid</div><span class="t">Official</span></div><div class="c"><div class="k">3.50</div><div class="l">Cumulative GPA to retain an AUK scholarship</div><span class="t">Official</span></div><div class="c"><div class="k">12</div><div class="l">Minimum credits per semester for full-time status</div><span class="t">Official</span></div><div class="c"><div class="k">30</div><div class="l">Minimum credits in residence for a second degree</div><span class="t">Official</span></div></div>
<div class="c"><h3>Support and retention structures</h3><p style="margin:0">The Academic Advising Center advises all first-year and new transfer students and runs retention advising for declared students on academic probation. The Writing and Tutoring Centers, Counseling Center and Alumni Affairs and Career Development office support progress and outcomes. No retention or completion rates accompany these descriptions.</p>${src(a(S.cat,'AUK Catalog 2025–26, pp.16, 49–50')+'.')}</div>
<div class="g2" style="margin-top:12px">${na('First-year retention rate')}${na('Graduation rate / time to degree')}${na('Annual graduates')}${na('IEP completion and progression')}</div>`;
V.programs=()=>`<h1>Colleges &amp; Programs</h1><p class="lead">Three colleges, an Intensive English Program, and 16 undergraduate majors in the 2025–26 catalog.</p>
<div class="g">${kpi('3','Colleges','Official')}${kpi('16','Undergraduate majors (5 + 6 + 5)','Calculated')}${kpi('13','“Thirteen degree programs” in an older text','Secondary')}${kpi('45','General education credits required','Official')}</div>
<div class="c"><h3>Program portfolio</h3><div class="chips" id="chips" role="group" aria-label="Filter by college">${['All','Arts & Sciences','Business & Economics','Engineering & Applied Sciences'].map((x,i)=>`<button data-c="${x}" class="${i?'':'on'}">${x}</button>`).join('')}</div><div class="tw"><table id="pt"></table></div><p class="l" id="pn"></p>${src(a(S.cat,'AUK Catalog 2025–26, table of contents and pp.13–14')+'. Accreditation column restates the catalog; “Not listed” means the catalog does not list the program as accredited.')}</div>
<h2>Portfolio shape</h2><div class="g"><div class="c"><div class="k">5</div><div class="l">Arts &amp; Sciences majors (31%)</div><span class="t">Calculated</span></div><div class="c"><div class="k">6</div><div class="l">Business &amp; Economics majors (38%)</div><span class="t">Calculated</span></div><div class="c"><div class="k">5</div><div class="l">Engineering &amp; Applied Sciences majors (31%)</div><span class="t">Calculated</span></div><div class="c"><div class="k">3 of 5</div><div class="l">Engineering/computing majors listed as ABET-accredited</div><span class="t">Calculated</span></div></div>
<div class="c"><h3>Accreditation coverage ${dtag('D5')}</h3><p style="margin:0">The catalog lists AACSB for the College of Business &amp; Economics, AALE for Arts &amp; Sciences, CEA for the Intensive English Program, NASAD equivalency for the Design degree, and ABET for Computer Engineering, Electrical Engineering and Computer Science. Systems Engineering and Information Systems are not listed. Program count shares are by title, not by student numbers.</p>${src(a(S.cat,'AUK Catalog 2025–26, pp.13–14')+'.')}</div>
<div class="g2" style="margin-top:12px">${na('Enrollment by college')}${na('Enrollment by major')}${na('Graduates by major')}${na('Program growth over time')}</div>`;
V.demographics=()=>`<h1>Student Demographics</h1><p class="lead">AUK publishes no gender or nationality statistics. One official indicator, scholarship share, describes who studies at AUK.</p>
<div class="g">${kpi('&gt;50%','Students served as scholarship students','Official')}${kpi('86%','International faculty (QS, 97 faculty)','Ranking')}${kpi('Not public','Gender ratio','Unavailable')}${kpi('Not public','Nationality mix','Unavailable')}</div>
<div class="c"><h3>Scholarship reliance</h3><svg viewBox="0 0 640 60" role="img" aria-label="More than half of students are scholarship students"><rect x="10" y="14" width="310" height="30" fill="#7b1a2e" rx="4"/><rect x="320" y="14" width="310" height="30" fill="#eadfc8" rx="4"/><text x="20" y="34" style="fill:#fff">More than 50%: scholarship students</text><text x="330" y="34" style="fill:#2a1218">Remainder: not specified</text></svg><p class="l">The Office of Scholarship and Financial Aid states it serves more than fifty percent of the student population as scholarship students. The split among PUC government seats, AUK merit awards and private sponsors is not published. <span class="t">Official</span></p>${src(a(S.cat,'AUK Catalog 2025–26, pp.40–42')+'.')}</div>
<div class="c" style="margin-top:12px"><h3>Context from the catalog</h3><p style="margin:0">The Private Universities Council (PUC) allocates internal government scholarship seats to Kuwaiti students and children of Kuwaiti mothers, covering tuition and a book allowance. AUK serves Kuwaiti nationals, expatriates living in Kuwait and international students; no counts are given.</p>${src(a(S.cat,'AUK Catalog 2025–26, pp.22, 42')+'.')}</div>
<div class="g2" style="margin-top:12px">${na('Kuwaiti vs non-Kuwaiti students')}${na('Female / male students')}${na('Age and full-time status')}${na('Scholarship split by funder')}</div>
<p class="src">A third-party encyclopedia lists a Kuwaiti/international split and a nationality count for 2018. It is uncited and was excluded.</p>`;
V.faculty=()=>`<h1>Faculty &amp; Staff</h1><p class="lead">The catalog states a current faculty count and PhD share. Older third-party figures differ by date.</p>
<div class="g">${kpi('123','Faculty members, 2025–26 (“over 123”)','Official')}${kpi('92%','PhD or terminal degree','Official')}${kpi('17–24','Typical class size','Official')}${kpi('86%','International faculty (QS)','Ranking')}</div>
<div class="c"><h3>PhD share by source ${dtag('D4')}</h3>${bars([['AUK catalog 2025–26',92,'#7b1a2e'],['Edarabia directory (older)',81,'#8a8f99']],100,'%')}<p class="l">The two figures come from different dates and sources, so they should not be read as a trend. <span class="t">Official</span> <span class="t">Secondary</span></p>${src(a(S.cat,'AUK Catalog 2025–26, p.12')+'; '+a(S.eda,'Edarabia')+'.')}</div>
<h2>Faculty counts by source ${dtag('D3')}</h2><div class="c"><h3>Counts</h3>${bars([['Catalog 2025–26 (“over 123”)',123,'#7b1a2e'],['Edarabia (“over 114”)',114,'#8a8f99'],['QS profile (undated)',97,'#a85d00']],130)}<p class="l">uniRank gives a 100–199 range. Non-faculty staff: Edarabia lists 300 staff in total (undated, secondary).</p>${src(a(S.cat,'Catalog p.12')+'; '+a(S.eda,'Edarabia')+'; '+a(S.qs,'QS')+'; '+a(S.uni,'uniRank')+'.')}</div>
<div class="c" style="margin-top:12px"><h3>Ratios</h3><p style="margin:0">QS's older text cites a typical 1-to-17 faculty-to-student ratio. A current ratio cannot be computed because no same-date student and faculty figures are public. The catalog's class-size range (17 to 24) is a different measure.</p></div>
<div class="g2" style="margin-top:12px">${na('Faculty by rank or college')}${na('Full-time / part-time faculty')}${na('Faculty nationality (count)')}${na('Staff headcount (official)')}</div>`;
V.research=()=>`<h1>Research</h1><p class="lead">AUK is a teaching-centered liberal arts institution. Public research indicators are limited to an index signal and named offices.</p>
<div class="g">${kpi('1','Nature Index article count (12-month window)','Ranking')}${kpi('0.17','Nature Index share','Ranking')}${kpi('6th','Among 7 Kuwait institutions listed by share','Calculated')}${kpi('Not public','Total publications','Unavailable')}</div>
<div class="c"><h3>Reading the Nature Index signal</h3><p style="margin:0">The Nature Index tracks primary research articles in a selected set of journals over a rolling 12-month window (1 June 2025 to 30 May 2026 on the retrieved page). It captures a narrow slice of output, favouring natural and health sciences, so it understates a liberal arts institution’s work in humanities and business.</p>${src(a(S.nat,'Nature Index — Kuwait country page')+'.')}</div>
<div class="c" style="margin-top:12px"><h3>Research structures named by AUK</h3><p style="margin:0">Office of Research &amp; Grants (funding, training and engagement for faculty research), the Oral History &amp; Documentation Project (recorded interviews on Kuwait’s pre-oil and wartime history), the Center for Teaching Excellence, a Gulf Studies certificate, and publications such as the AUK Kuwait Review and Occasional Papers.</p>${src(a(S.cat,'AUK Catalog 2025–26, pp.19–20')+'; '+a(S.pub,'University publications page')+'.')}</div>
<div class="g2" style="margin-top:12px">${na('Scopus / WoS publication counts (verified)')}${na('Research funding (total)')}${na('Citations per faculty')}${na('Output by college')}</div>`;
V.quality=()=>`<h1>Accreditation &amp; Quality</h1><p class="lead">AUK’s strongest public evidence base is its catalog: national accreditation, a long-running US partnership and seven international accreditation statements.</p>
<div class="g">${kpi('2003','Amiri Decree 139 (July 8)','Official')}${kpi('2006','PUC institutional accreditation (Feb 1)','Official')}${kpi('7','International accreditation statements','Calculated')}${kpi('2028','Dartmouth agreement term end','Official')}</div>
<div class="c tw"><h3>Accreditation portfolio</h3><table class="wr"><tr><th>Body</th><th>Scope</th></tr><tr><td>PUC / Ministry of Higher Education</td><td>Institutional accreditation, since Feb 1, 2006</td></tr><tr><td>AACSB</td><td>College of Business &amp; Economics</td></tr><tr><td>AALE</td><td>College of Arts &amp; Sciences (liberal education)</td></tr><tr><td>ABET (Engineering)</td><td>BE Computer Engineering; BE Electrical Engineering</td></tr><tr><td>ABET (Computing)</td><td>BS Computer Science</td></tr><tr><td>NASAD</td><td>BA Design: substantial equivalency</td></tr><tr><td>CEA</td><td>Intensive English Program</td></tr></table>${src(a(S.cat,'AUK Catalog 2025–26, pp.12–14')+'. The seven statements are the seven bullets in the catalog (counted by me).')}</div>
<h2>Dartmouth partnership</h2><div class="c"><p style="margin:0">Dartmouth College is the international partner institution defined by the PUC (Resolution 5/21-2/2005). The agreement dates from a 2003 memorandum, was renewed a fourth time in March 2023 and runs through 2028. Dartmouth provides academic and administrative consulting; AUK is not part of Dartmouth.</p>${src(a(S.cat,'AUK Catalog 2025–26, p.13')+'.')}</div>
<div class="c" style="margin-top:12px"><h3>Institutional research capacity</h3><p style="margin:0">The Office of Institutional Research reports to the Board of Trustees and leadership, handles external reporting to government and accreditors, and monitors enrollment, retention, graduation and faculty trends. It follows the AIR Code of Ethics. No public fact book or data report was located.</p>${src(a(S.oir,'AUK OIR page')+'.')}</div>
<div class="g2" style="margin-top:12px">${na('International institutional review report (e.g. QAA-type) for AUK')}${na('Accreditation review dates and outcomes by body')}</div>`;
V.benchmark=()=>`<h1>Benchmark &amp; External Context</h1><p class="lead">The one comparable, public peer dataset located is the Nature Index table for Kuwait. World-ranking positions and national statistics are not used.</p>
<div class="c tw"><h3>Nature Index: Kuwait institutions by share</h3><table><tr><th>Institution</th><th>Count</th><th>Share</th></tr><tr><td>American University of the Middle East</td><td>65</td><td>2.66</td></tr><tr><td>Kuwait University</td><td>66</td><td>1.56</td></tr><tr><td>Kuwait Institute for Scientific Research</td><td>3</td><td>1.12</td></tr><tr><td>Gulf University for Science and Technology</td><td>4</td><td>0.66</td></tr><tr><td>Australian University</td><td>1</td><td>0.20</td></tr><tr style="font-weight:700"><td>American University of Kuwait</td><td>1</td><td>0.17</td></tr><tr><td>Ministry of Health Kuwait</td><td>1</td><td>0.05</td></tr></table><p class="l">Window 1 June 2025 to 30 May 2026. Count = articles; share = fractional author contribution. Names as listed by Nature Index. <span class="t">Ranking</span></p>${src(a(S.nat,'Nature Index — Kuwait')+'. This table is external context only; peer figures are not reused elsewhere.')}</div>
<div class="c" style="margin-top:12px"><h3>How to read it</h3><p style="margin:0">AUK ranks sixth of seven listed institutions by share. The index counts a narrow journal set, so it favours institutions with natural-science and health output and understates a liberal arts profile. It is not a measure of teaching quality or overall research performance.</p></div>
<div class="c" style="margin-top:12px"><h3>World rankings and national context: not included</h3><p style="margin:0">No current THE or QS world position for AUK could be verified (a QS page shows a band without naming the subject). Kuwait’s Central Statistical Bureau publishes education statistics (${a(S.csb,'CSB')}) but the files could not be accessed, and secondary substitutes were deliberately excluded.</p></div>
<div class="g2" style="margin-top:12px">${na('Peer enrollment, Kuwait private universities (PUC / MoHE / CSB)')}${na('Peer faculty and retention comparisons')}</div>`;
V.insights=()=>`<h1>Insights</h1><p class="lead">Seven findings, each separated into fact, insight, question and recommendation. Recommendations are analytical judgment, not university-reported facts.</p><div class="g2">
${ins('Headcount definition','Public student figures range from 2,077 to 10,000; the only dated figures are 2,419 (Fall 2018) and 2,256+ (c.2023).','The data suggests inconsistent definitions across directories and profiles, and at least one implausible figure.','Which headcount (term, FTE, UG only, IEP included) does AUK treat as official?','Publish one dated, defined headcount each Fall.')}
${ins('Faculty strength','The 2025–26 catalog states over 123 faculty, 92% with a PhD or terminal degree, and classes of 17 to 24.','Official figures are stronger than older third-party counts, though different dates prevent a trend claim.','How has the faculty count changed since 2018 on a consistent definition?','Add a faculty table to a public fact book.')}
${ins('Scholarship reliance','More than 50% of students are served as scholarship students; PUC allocates government seats annually.','Enrollment and revenue are exposed to scholarship policy and seat allocation.','What is the split between PUC seats, AUK awards and private sponsors?','Track and disclose scholarship share by funder.')}
${ins('Accreditation breadth','AACSB, AALE, CEA, NASAD equivalency and ABET for three programs; Systems Engineering and Information Systems are not listed.','Quality assurance is broad, with a visible gap in two computing/engineering majors.','What is the accreditation plan for the two unlisted majors?','Publish an accreditation roadmap by program.')}
${ins('Portfolio growth','The 2025–26 catalog lists 16 majors; an older text cites thirteen degree programs.','The data suggests the portfolio has expanded, though the older text is undated.','Which majors were added, and with what enrollment?','Provide a program-launch timeline with enrollment.')}
${ins('Research visibility','Nature Index: 1 article, share 0.17, sixth of seven listed Kuwait institutions.','The index captures a narrow slice; AUK’s humanities and business output is largely invisible to it.','Which indexes would represent AUK’s research fairly?','Publish annual Scopus-based totals by college.')}
${ins('Transparency gap','OIR monitors enrollment, retention, graduation and faculty trends internally; no public report was found.','Data exists internally, so publication is a choice, not a capacity limit.','Which five indicators would anchor a public fact book?','Publish an annual fact book with defined enrollment, retention and graduation metrics.')}
</div>`;
V.method=()=>`<h1>Methodology &amp; Data Quality</h1><div class="c"><h3>Source hierarchy and classifications</h3><p style="margin:0"><b>Official</b>: AUK’s catalog and website. <b>University-supplied</b>: AUK facts on its partner’s page. <b>Ranking</b>: QS and Nature Index. <b>Secondary</b>: uniRank, Edarabia, CIC, Wikipedia. <b>Calculated</b>: arithmetic on published values. <b>Discrepancy</b>: unresolved conflict. Parent-company, ranking and secondary data are never presented as official institutional data. No estimates are used.</p></div>
<h2>Calculations</h2><div class="c"><p style="margin:0">Fall 2018 shares divide by 2,419 (2,219 + 200 = 2,419). Program counts are catalog titles (5 + 6 + 5 = 16). Nature Index position is by share among the seven listed institutions. No growth rate or ratio is computed where the bases differ.</p></div>
<h2>Discrepancy register</h2><div class="c tw"><table class="wr"><tr><th>ID</th><th>Item</th><th>Figures</th><th>Status</th></tr>
<tr><td>D1</td><td>Student headcount</td><td>2,419 (Fall 2018) · 2,256+ (c.2023) · 2,077 (QS) · 2,000–2,999 (uniRank) · ≈3,000 (Edarabia) · 10,000 (CIC)</td><td>Unresolved; dates and bases differ</td></tr>
<tr><td>D2</td><td>Graduate students</td><td>1,000 (CIC) vs no graduate degrees in the 2025–26 catalog</td><td>Unresolved; CIC likely outdated or erroneous</td></tr>
<tr><td>D3</td><td>Faculty count</td><td>97 (QS) · 114 (Edarabia) · over 123 (catalog 2025–26)</td><td>Different dates</td></tr>
<tr><td>D4</td><td>PhD share</td><td>92% (catalog) vs 81% (Edarabia)</td><td>Different dates and sources</td></tr>
<tr><td>D5</td><td>Program count</td><td>13 (older text) vs 16 majors (catalog)</td><td>Different dates and definitions</td></tr>
<tr><td>D6</td><td>Founding year</td><td>2003 (Amiri Decree) vs 2004 (opening term, some profiles)</td><td>Resolved: decree 2003, classes from fall 2004</td></tr></table></div>
<h2>Limitations</h2><div class="c"><ul style="margin:0;padding-left:18px"><li>No AUK fact book, annual report or institutional-research report was located; the OIR page lists functions only.</li><li>The AUK website “2256+” figure comes from a cached homepage whose date is approximate.</li><li>THE and QS world-ranking positions for AUK could not be verified and are not shown. Kuwait’s Central Statistical Bureau files were not accessible.</li><li>Visual identity: AUK’s partner page states “Maroon &amp; Gold”; exact hex values and fonts were not verified, so the palette is an approximation.</li><li>Catalog page numbers refer to printed pages of the 2025–26 catalog and may be off by one.</li></ul></div>
<h2>Sources</h2><div class="c"><ul style="margin:0;padding-left:18px;line-height:1.9"><li>${a(S.cat,'AUK Catalog 2025–26')} (official)</li><li>${a(S.oir,'AUK Office of Institutional Research')} · ${a(S.home,'AUK website')} · ${a(S.pub,'University publications')}</li><li>${a(S.dart,'Dartmouth–AUK program: About AUK')}</li><li>${a(S.nat,'Nature Index — Kuwait')}</li><li>${a(S.qs,'TopUniversities (QS) — AUK')}</li><li>${a(S.uni,'uniRank')} · ${a(S.eda,'Edarabia')} · ${a(S.cic,'CIC')} (secondary) · ${a(S.wiki,'Wikipedia')} (not used for figures)</li><li>${a(S.csb,'Kuwait Central Statistical Bureau')} (files not accessible)</li></ul></div>`;
const NAV=[['overview','Overview'],['students','Students'],['admissions','Admissions'],['journey','Journey'],['programs','Programs'],['demographics','Demographics'],['faculty','Faculty'],['research','Research'],['quality','Quality'],['benchmark','Benchmark'],['insights','Insights'],['method','Method']];
document.getElementById('nav').innerHTML=NAV.map(([h,t])=>`<a href="#${h}" data-h="${h}">${t}</a>`).join('');
function progTable(c){const r=PROG.filter(p=>c==='All'||p[2]===c);document.getElementById('pt').innerHTML='<tr><th>Major</th><th>Degree</th><th>Accreditation (catalog)</th></tr>'+r.map(p=>`<tr><td>${p[0]}</td><td>${p[1]}</td><td>${p[3]}</td></tr>`).join('');document.getElementById('pn').textContent=r.length+' of 16 majors shown'+(c==='All'?'':' · '+Math.round(r.length/16*100)+'% of the portfolio')}
function go(){const h=(location.hash||'#overview').slice(1);const v=V[h]?h:'overview';
document.querySelectorAll('nav a').forEach(x=>x.classList.toggle('on',x.dataset.h===v));
document.getElementById('app').innerHTML=(v==='overview'?'':`<div class="crumb"><a href="#overview">← Overview</a> / ${NAV.find(n=>n[0]===v)[1]}</div>`)+V[v]()+(v==='overview'?'':`<p style="margin-top:28px"><a class="x" href="#overview">← Back to Overview</a> · <a class="x" href="#method">Methodology &amp; sources →</a></p>`);
if(v==='programs'){progTable('All');document.querySelectorAll('#chips button').forEach(b=>b.onclick=()=>{document.querySelectorAll('#chips button').forEach(x=>x.classList.remove('on'));b.classList.add('on');progTable(b.dataset.c)})}
document.title='AUK Analytics — '+NAV.find(n=>n[0]===v)[1];scrollTo({top:0,behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'auto':'smooth'})}
addEventListener('hashchange',go);go();
</script></body></html>
