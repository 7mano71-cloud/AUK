.k{font-size:clamp(22px,3.4vw,30px);font-weight:700;color:var(--blue);line-height:1.05;overflow-wrap:anywhere}.l{font-size:13px;color:var(--mut);margin-top:5px}
.t{display:inline-block;font-size:11px;padding:2px 8px;border-radius:99px;background:var(--soft);color:var(--ink);margin:6px 4px 0 0;font-weight:600}
.t.d{background:#fde7d3;color:#7a3f00}
.src{font-size:12px;color:var(--mut);margin-top:10px}.src a,a.x{color:var(--blue)}
.nav{display:block;text-decoration:none;color:inherit;border-left:4px solid var(--blue);transition:.2s}.nav:hover{transform:translateY(-2px);box-shadow:0 6px 18px #0002}
.nav b{display:block;font-size:17px}.nav span{font-size:13px;color:var(--mut)}.nav i{font-style:normal;color:var(--blue);font-weight:600;font-size:14px;display:block;margin-top:8px}
.na{background:repeating-linear-gradient(45deg,var(--card),var(--card) 8px,var(--bg) 8px,var(--bg) 16px);color:var(--mut);font-size:14px}
.ins{border-top:4px solid var(--blue)}.ins p{margin:4px 0;font-size:14.5px}.ins em{font:600 11px system-ui;font-style:normal;text-transform:uppercase;letter-spacing:.08em;color:var(--blue);display:block;margin-top:8px}
svg{width:100%;height:auto;display:block}svg text{fill:var(--mut);font:11px system-ui}
.tw{overflow-x:auto}table{border-collapse:collapse;width:100%;font-size:14px}th,td{padding:8px 10px;border-bottom:1px solid var(--line);text-align:right;white-space:nowrap}th:first-child,td:first-child{text-align:left}th{color:var(--mut);font-weight:600;font-size:12px}
.wr th,.wr td{white-space:normal;text-align:left;vertical-align:top}
.hero{border-left:6px solid var(--blue);padding:6px 0 6px 16px;margin-bottom:10px}.eyebrow{font:700 11px system-ui;letter-spacing:.14em;text-transform:uppercase;color:var(--blue)}.sub{font-size:clamp(16px,3vw,20px);margin:0 0 8px}.by{font-size:13px;color:var(--mut);margin-top:8px}.by b{color:var(--ink)}.by small{display:block;margin-top:2px;font-size:12px}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0}.chips button{min-height:44px;padding:0 16px;border-radius:99px;border:1px solid var(--line);background:var(--card);color:var(--ink);font:600 14px system-ui;cursor:pointer}.chips button.on{background:var(--blue);color:#fff;border-color:var(--blue)}
.fn{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0}.fn div{flex:1 1 130px;padding:12px;border-radius:10px;background:var(--soft);text-align:center}.fn b{display:block;font-size:20px;color:var(--blue)}.fn small{color:var(--mut)}.fn div.n{background:transparent;border:1.5px dashed var(--line)}.fn div.n b{color:var(--mut);font-size:13px}
.bm{height:14px;background:var(--line);border-radius:7px;position:relative;margin:6px 0 2px}.bm i{position:absolute;inset:0 auto 0 0;background:var(--blue);border-radius:7px}.bm u{position:absolute;top:-4px;bottom:-4px;width:3px;background:var(--warn)}
footer{border-top:1px solid var(--line);padding:22px 16px;text-align:center;color:var(--mut);font-size:12.5px}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

/* ---- visual enhancement pass (hero, glass, typography) ---- */
:root{--photo:url(data:image/jpeg;base64,);--art:url(data:image/svg+xml;base64,);--gl:rgba(255,255,255,.62);--gl-b:rgba(255,255,255,.75);--sh:0 10px 34px rgba(20,33,61,.10)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--gl:rgba(23,32,51,.62);--gl-b:rgba(255,255,255,.12);--sh:0 10px 34px rgba(0,0,0,.35)}}
header{background:rgba(123,26,46,.94);-webkit-backdrop-filter:blur(16px) saturate(150%);backdrop-filter:blur(16px) saturate(150%);box-shadow:0 6px 24px rgba(0,0,0,.18)}
main{position:relative;isolation:isolate}
main::before{content:"";position:absolute;inset:0 0 auto 0;height:340px;z-index:-1;background:radial-gradient(circle at 12% 0%,rgba(123,26,46,.20),transparent 46%),radial-gradient(circle at 92% 8%,rgba(233,178,31,.30),transparent 42%);pointer-events:none}
h1,h2,h3{font-family:'Palatino Linotype','Book Antiqua',Palatino,Georgia,serif}
h1{font-weight:700;letter-spacing:-.01em}
main>h1{background:var(--gl);border:1px solid var(--gl-b);border-bottom:0;border-radius:18px 18px 0 0;padding:16px 18px 4px;margin:8px 0 0;-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);box-shadow:var(--sh)}
main>h1+.lead{background:var(--gl);border:1px solid var(--gl-b);border-top:0;border-radius:0 0 18px 18px;padding:2px 18px 16px;margin:0 0 16px;max-width:none;-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);box-shadow:var(--sh)}
.g .c{background:linear-gradient(145deg,var(--gl-b),var(--card));box-shadow:var(--sh)}
.hero.hp+.g{position:relative}
.hero.hp+.g::before{content:"";position:absolute;inset:-10px;border-radius:22px;background:linear-gradient(120deg,#4d0f1c,#7b1a2e);z-index:0}
.hero.hp+.g .c{position:relative;z-index:1;background:rgba(255,255,255,.80);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);border-color:rgba(255,255,255,.7)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .hero.hp+.g .c{background:rgba(23,32,51,.78)}}
.ins{background:linear-gradient(180deg,var(--gl-b),var(--card));box-shadow:var(--sh);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
.hero.hp{position:relative;border:0;padding:clamp(18px,4vw,36px);margin:0 0 30px;min-height:min(74vh,540px);border-radius:26px;overflow:hidden;display:flex;align-items:flex-end;background-color:#4d0f1c;background-image:linear-gradient(180deg,rgba(8,12,24,.18) 0%,rgba(8,12,24,.62) 100%),linear-gradient(90deg,rgba(8,12,24,.45),rgba(8,12,24,0) 70%),var(--photo),var(--art);background-size:cover;background-position:center;box-shadow:0 24px 60px rgba(20,33,61,.22)}
.hp .glass{width:min(100%,640px);padding:clamp(18px,3.4vw,30px);border-radius:24px;color:#fff;background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.34);-webkit-backdrop-filter:blur(18px) saturate(140%);backdrop-filter:blur(18px) saturate(140%);box-shadow:0 22px 50px rgba(0,0,0,.30),inset 0 1px 0 rgba(255,255,255,.3)}
.hp .eyebrow{color:#f6d58a}.hp h1{color:#fff;font-size:clamp(30px,6.4vw,52px);margin:6px 0 6px;text-shadow:0 2px 18px rgba(0,0,0,.35)}
.hp .sub{color:#fff;font-size:clamp(15px,2.8vw,19px);margin:0 0 8px;opacity:.95}.hp .lead{color:rgba(255,255,255,.88);font-size:15px;margin:0 0 10px}
.hp .by{color:rgba(255,255,255,.82);margin-top:10px}.hp .by b{color:#fff}.hp .by small{color:rgba(255,255,255,.75)}
.hp .disc{font-size:12px;color:rgba(255,255,255,.78);margin:12px 0 0;padding-top:10px;border-top:1px solid rgba(255,255,255,.25)}
.cta{display:inline-flex;align-items:center;gap:8px;margin-top:14px;min-height:48px;padding:0 22px;border-radius:99px;background:#fff;color:#4d0f1c;font:700 15px system-ui;text-decoration:none;box-shadow:0 8px 22px rgba(0,0,0,.25);transition:.2s}.cta:hover{transform:translateY(-2px)}
.credit{position:absolute;right:14px;top:10px;font-size:11px;color:rgba(255,255,255,.8);background:rgba(0,0,0,.35);padding:3px 9px;border-radius:99px}
@media (max-width:520px){.hero.hp{min-height:520px;border-radius:20px}.hp .glass{border-radius:20px}}
